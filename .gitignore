/target
# Rust example workspaces each produce their own target/ and Cargo.lock
examples/rust/*/target/
# LMDB runtime data created by Rust SDK pipelines/tests
.synor_db/
# Local run manifests and metadata-only audit logs
.synor/
examples/rust/files_transform/output_html/
examples/rust/pdf_to_markdown/out/
# Downloaded embedding model cache (fastembed) — e.g. code-embedding example
.fastembed_cache/

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]

# C extensions
*.so
# Windows: maturin emits debug symbols next to the extension module. The
# extension itself (core.pyd) is already covered by *.py[cod] above, but the
# .pdb is not -- it is tens of MB and must not be committed.
*.pdb

# Test residue from the CLI suite (generated apps, LMDB lock dirs, outputs)
python/tests/cli/synor.db/
python/tests/cli/out_*/
python/tests/cli/cli_init_project/

# Distribution / packaging
.venv*/
dist/
uv.lock

.DS_Store

*.egg-info/

/.vscode
/*.session.sql

.mypy_cache
.dmypy.json

# LMDB files
*.mdb

# Output of `synor eval`
examples/**/eval_*
examples/**/uv.lock
**/lancedb_data/

# Synor Code (ccc)
/.synor_code/

# Claude Code local state
.claude/*.lock
