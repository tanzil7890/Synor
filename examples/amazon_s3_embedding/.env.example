# Example environment variables for this example
# Copy this to .env and fill in your actual values

SYNOR_DB=./synor.db

# Postgres database address for synor
POSTGRES_URL=postgres://synor:synor@localhost/synor

# Amazon S3 Configuration
S3_BUCKET=synor-example-data

# Optional: only list objects under this prefix
S3_PREFIX=markdown_files/

# Optional: only list objects under this prefix
# S3_PREFIX=

# Optional: S3-compatible endpoint (e.g. MinIO)
# AWS_ENDPOINT_URL=http://localhost:9000

# Fallback to CPU for operations not supported by MPS on Mac.
# It's no-op for other platforms.
PYTORCH_ENABLE_MPS_FALLBACK=1
