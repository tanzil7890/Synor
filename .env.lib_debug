export RUST_LOG=warn,synor=trace,synor_core=trace,synor_py=trace,synor_py_utils=trace,synor_utils=trace,tower_http=trace
export RUST_BACKTRACE=1

export SYNOR_SERVER_CORS_ORIGINS=http://localhost:3000

# Set SYNOR_DEV_ROOT to the directory containing this file (repo root)
# This allows running examples from any subdirectory
export SYNOR_DEV_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Function for running examples with the local editable synor package
# Usage: synor-dev-run synor update main
synor-dev-run() {
    local pyver
    if [ -f "$SYNOR_DEV_ROOT/.python-version" ]; then
        pyver="$(cat "$SYNOR_DEV_ROOT/.python-version")"
    else
        pyver="3.11"
    fi

    uv run --python "$pyver" --with-editable "$SYNOR_DEV_ROOT" "$@"
}
