---
interface Props {
  mobileSheetId?: string;
}
const { mobileSheetId } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="topbar">
  <a class="topbar-brand" href={`${base}/`} aria-label="Synor documentation">
    <img src={`${base}/images/synor-mark.svg`} alt="" width="34" height="34" />
    <span class="topbar-name">Synor</span>
    <small>alpha</small>
  </a>
  <nav class="topbar-nav" aria-label="Primary navigation">
    <a href={`${base}/getting_started/quickstart/`}>First run</a>
    <a href={`${base}/programming_guide/core_concepts/`}>Work model</a>
    <a href={`${base}/connectors/`}>Integrations</a>
    <a href={`${base}/examples/`}>Field notes</a>
  </nav>
  {mobileSheetId && (
    <button
      class="mobile-open"
      type="button"
      aria-controls={mobileSheetId}
      aria-expanded="false"
      aria-label="Open menu"
    >
      Menu
    </button>
  )}
</header>

<script>
  const initializeCopyButtons = () => {
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((container) => {
      const button = container.querySelector<HTMLButtonElement>('.copy');
      if (!button || button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.addEventListener('click', async () => {
        const value = container.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => { button.textContent = original; }, 1200);
        } catch {
          button.textContent = 'Copy failed';
        }
      });
    });
  };
  document.addEventListener('DOMContentLoaded', initializeCopyButtons);
</script>
